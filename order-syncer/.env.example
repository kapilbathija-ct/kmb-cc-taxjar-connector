CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_REGION=us-central1.gcp
# Required in practice for local dev, even though validation treats it as
# optional - without it, the auth middleware falls back to the literal scope
# string 'default', which commercetools rejects with invalid_scope. Use a
# real scope, e.g. manage_project:<your-project-key>.
CTP_SCOPE=

# Only needed for local dev - in a real deployment Connect provisions the
# Pub/Sub topic/subscription (or SNS topic) itself and injects these.
CONNECT_SUBSCRIPTION_DESTINATION=GoogleCloudPubSub
CONNECT_GCP_TOPIC_NAME=
CONNECT_GCP_PROJECT_ID=
CONNECT_AWS_TOPIC_ARN=

# TaxJar
TAX_PROVIDER_API_TOKEN=
# 'sandbox' (default, calls api.sandbox.taxjar.com) or 'live'
TAX_PROVIDER_ENV=sandbox
TAXJAR_FROM_COUNTRY=US
TAXJAR_FROM_STATE=
TAXJAR_FROM_ZIP=
