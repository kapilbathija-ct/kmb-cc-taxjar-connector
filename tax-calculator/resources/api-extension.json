{
  "key": "${ctpTaxCalculatorExtensionKey}",
  "destination": {
    "type": "HTTP",
    "url": "${ctpExtensionBaseUrl}",
    "authentication": {
      "type": "AuthorizationHeaderAuthentication",
      "headerValue": "Bearer ${extensionAuthToken}"
    }
  },
  "triggers": [
    {
      "resourceTypeId": "cart",
      "actions": ["Update"],
      "condition": "taxMode=\"ExternalAmount\" and cartState=\"Frozen\""
    }
  ],
  "timeoutInMs": 2000
}