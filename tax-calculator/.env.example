CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_REGION=us-central1.gcp
# Required in practice for local dev (e.g. running connector:post-deploy),
# even though validation treats it as optional - without it, the auth
# middleware falls back to the literal scope string 'default', which
# commercetools rejects with invalid_scope. Use a real scope, e.g.
# manage_project:<your-project-key>.
CTP_SCOPE=

# TaxJar
TAX_PROVIDER_API_TOKEN=
# 'sandbox' (default, calls api.sandbox.taxjar.com) or 'live'
TAX_PROVIDER_ENV=sandbox
# Merchant's ship-from / nexus address, used as TaxJar's "from_*" fields
TAXJAR_FROM_COUNTRY=US
TAXJAR_FROM_STATE=
TAXJAR_FROM_ZIP=

# Shared secret the commercetools API Extension must present on every call to
# this connector (Bearer token) - generate with e.g. `openssl rand -hex 24`
EXTENSION_AUTH_TOKEN=

# Only needed for local dev / running connector:post-deploy manually - in a
# real deployment Connect injects this automatically.
CONNECT_SERVICE_URL=http://localhost:8080
